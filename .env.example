# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MIDTRANS_SERVER_KEY: Server key from Midtrans Dashboard (Sandbox or Production)
MIDTRANS_SERVER_KEY=""

# MIDTRANS_CLIENT_KEY: Client key from Midtrans Dashboard (Sandbox or Production)
MIDTRANS_CLIENT_KEY=""

# MIDTRANS_IS_PRODUCTION: Set to "true" for production, "false" or empty for sandbox
MIDTRANS_IS_PRODUCTION="false"

# DATABASE_URL: PostgreSQL connection string (e.g., Neon, Supabase, local)
DATABASE_URL=""

# Cloudflare Turnstile keys
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ADMIN_EMAIL: Email for admin login
ADMIN_EMAIL="admin@kopi-kita.com"

# ADMIN_PASSWORD: Password for admin login
ADMIN_PASSWORD=""

# --- MCP + OAuth (optional; MCP stays disabled until OAuth vars are complete) ---
# Public HTTPS origin of this app, no trailing slash. Must match the deployed domain exactly.
# APP_URL="https://your-domain.example"
# MCP_OAUTH_ISSUER="https://your-domain.example"
# Static OAuth client for e.g. Gemini Spark (generate long random values)
# MCP_OAUTH_CLIENT_ID=""
# MCP_OAUTH_CLIENT_SECRET=""
# Required JWT signing secret (long random value; never commit a real one)
# MCP_OAUTH_SIGNING_SECRET=""
# Optional, leave empty: the redirect URI comes from your MCP client.
# Only set this if a client (e.g. Gemini) gives you a fixed "Copy redirect URI" value
# that is rejected. Loopback (localhost/127.0.0.1) client redirects are always allowed.
# MCP_OAUTH_REDIRECT_URIS=""
# MCP_OAUTH_TOKEN_EXPIRY="3600"
# Set to "true" to enable Dynamic Client Registration at /oauth/register
# MCP_OAUTH_DCR_ENABLED="false"
# Optional local-only static bearer token (read scope only, e.g. MCP Inspector)
# MCP_STATIC_TOKEN=""
